# =============================================================================
# Multi-Tenant LMS SaaS — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)
#
# NEVER commit .env to version control.
# NEVER put real secrets in this file.
#
# For CI/CD, inject these as environment secrets (GitHub Secrets, etc.).
# For local development, docker-compose up -d starts PostgreSQL and Redis.
# =============================================================================

# ---------------------------------------------------------------------------
# Application environment
# One of: development | staging | production
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL via Supabase)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
#
# Local development (docker-compose): use the value below as-is.
# Supabase cloud: copy the connection string from Project Settings > Database.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lms_dev

# ---------------------------------------------------------------------------
# Redis
# Local development (docker-compose): use the value below as-is.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# JWT Authentication
# Generate a secure secret: openssl rand -hex 32
# Must be at least 32 characters.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32_minimum_length
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Supabase
# From your Supabase project dashboard: Settings > API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# NEVER expose this key to the frontend — backend only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=lms-dev

# ---------------------------------------------------------------------------
# CORS — must match the Origin header the browser sends
# Local development: http://localhost:3000
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cookie security
# COOKIE_SECURE must be true in production (requires HTTPS)
# ---------------------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Frontend — Next.js public environment variables
# NEXT_PUBLIC_ prefix exposes these to the browser.
# Do NOT put secrets in NEXT_PUBLIC_ variables.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

